@@ -0,0 +1,51 @@
+package flannel
+
+import (
+	"net"
+	"strings"
+	"testing"
+)
+
+func TestSelectNodeIPv4(t *testing.T) {
+	vip := net.ParseIP("192.0.2.250")
+	node := net.ParseIP("192.0.2.10")
+	ifaceAddrs := []net.IP{vip, node}
+
+	t.Run("VIP precedes node address", func(t *testing.T) {
+		selected, err := selectNodeIPv4("eth0", ifaceAddrs, []net.IP{node})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !selected.Equal(node) {
+			t.Fatalf("selected %s, want %s", selected, node)
+		}
+	})
+
+	t.Run("node address absent from interface", func(t *testing.T) {
+		_, err := selectNodeIPv4("eth0", []net.IP{vip}, []net.IP{node})
+		if err == nil || !strings.Contains(err.Error(), "not assigned to flannel interface eth0") {
+			t.Fatalf("expected interface ownership error, got %v", err)
+		}
+	})
+
+	t.Run("IPv6 node address precedes IPv4", func(t *testing.T) {
+		selected, err := selectNodeIPv4("eth0", ifaceAddrs, []net.IP{net.ParseIP("2001:db8::10"), node})
+		if err != nil || !selected.Equal(node) {
+			t.Fatalf("selected %s, error %v; want %s", selected, err, node)
+		}
+	})
+
+	t.Run("no IPv4 node address", func(t *testing.T) {
+		_, err := selectNodeIPv4("eth0", ifaceAddrs, []net.IP{net.ParseIP("2001:db8::10")})
+		if err == nil || !strings.Contains(err.Error(), "no IPv4 node address") {
+			t.Fatalf("expected missing IPv4 error, got %v", err)
+		}
+	})
+
+	t.Run("no node addresses", func(t *testing.T) {
+		_, err := selectNodeIPv4("eth0", ifaceAddrs, nil)
+		if err == nil || !strings.Contains(err.Error(), "no IPv4 node address") {
+			t.Fatalf("expected missing node address error, got %v", err)
+		}
+	})
+}
