+      );
+      const recorded = JSON.stringify(messages);
+      assert.ok(recorded.includes(reason));
+      assert.ok(!recorded.includes("private upstream response"));
+    }
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
