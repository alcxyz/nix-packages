+        threadId: placeholder,
+        prefix: "placeholder",
+        startedAt: [
+          "2026-09-12T08:01:00.000Z",
+          "2026-09-12T08:02:00.000Z",
+          "2026-09-12T08:03:00.000Z",
+          "2026-09-12T08:04:00.000Z",
+          "2026-09-12T08:05:00.000Z",
