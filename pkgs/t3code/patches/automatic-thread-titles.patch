+        prefix: "long-task-fresh",
+        startedAt: ["2026-09-12T11:31:00.000Z"],
+      });
+      yield* TestClock.setTime(Date.parse("2026-09-12T12:00:00.000Z"));
+
+      const limiter = yield* AutomaticThreadTitleRateLimit;
